{
  "name": "arx-send",
  "version": "2.3.4",
  "description": "ARX Send - Disparo em massa via WhatsApp",
  "main": "src/main.js",
  "scripts": {
    "start": "node src/server.js",
    "electron": "electron .",
    "build": "electron-builder --win && node scripts/copy-asar.js",
    "build:server": "pkg src/server.js --output dist/arx-send-server.exe --compress GZip",
    "test": "node --test tests/utils.test.js tests/sessionService.test.js tests/sendService.test.js tests/sendFlow.test.js",
    "lint": "eslint src/ public/js/ --ext .js",
    "lint:fix": "eslint src/ public/js/ --ext .js --fix",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.arx.arx-send",
    "productName": "ARX Send",
    "copyright": "ARX Administradora",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "public/**/*",
      "package.json",
      "!src/loading.html"
    ],
    "extraResources": [
      {
        "from": "src/loading.html",
        "to": "loading.html"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo.png",
      "publish": [
        "github"
      ],
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "runAfterFinish": true,
      "artifactName": "ARX-Send-Setup-${version}.exe",
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046"
    },
    "publish": {
      "provider": "github",
      "owner": "alclord",
      "repo": "arx-send",
      "releaseType": "release"
    }
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/whatsapp-web.js/src/**/*",
      "node_modules/socket.io/client-dist/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^42.3.3",
    "electron-builder": "^26.8.1",
    "patch-package": "^8.0.1",
    "pkg": "^5.8.1"
  }
}
