{
  "name": "arx-send",
  "version": "1.0.0",
  "description": "ARX Send - Disparo em massa via WhatsApp",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "build": "pkg . --output dist/arx-send.exe --compress GZip"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/whatsapp-web.js/src/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "multer": "^1.4.5-lts.1",
    "qrcode": "^1.5.3",
    "socket.io": "^4.7.2",
    "whatsapp-web.js": "^1.34.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  }
}
